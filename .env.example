# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The final production URL. Baked into every booth QR code — set this
# BEFORE printing the booth kit, and redeploy with the cache cleared.
NEXT_PUBLIC_SITE_URL=https://fyv-passport.netlify.app

# No server-side secrets are needed. Facilitator accounts are created by hand in
# the Supabase dashboard, and the festival access code is that account's password
# — it never appears in this file or in the deployed JavaScript.
